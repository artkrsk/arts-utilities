{
  "name": "@arts/utilities",
  "version": "2.7.0",
  "type": "module",
  "description": "A collection of useful PHP and JS utility functions for developing a WordPress theme",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@artemsemkin/elementor-types": "^2.1.0"
  },
  "scripts": {
    "build": "node build.js",
    "build:prod": "pnpm types && pnpm lint && pnpm test && node build.js --production",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "types": "tsc --noEmit",
    "format": "prettier --write 'src/ts/**/*.ts' '__tests__/**/*.ts' '*.js'",
    "prepare": "husky"
  }
}
